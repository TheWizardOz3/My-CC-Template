{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit",
      "Write",
      "Read",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill(*)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh release delete *)",
      "Bash(vercel rm *)",
      "Bash(vercel remove *)",
      "Bash(vercel domains rm *)",
      "Bash(vercel env rm *)",
      "Bash(vercel alias rm *)",
      "Bash(vercel certs rm *)",
      "Bash(git branch -D *)",
      "Bash(git tag -d *)",
      "Bash(git update-ref -d *)",
      "Edit(~/.claude/**)",
      "Write(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Write(~/.claude.json)",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Gmail__delete_label",
      "mcp__claude_ai_Gmail__update_label",
      "mcp__firecrawl__firecrawl_browser_execute",
      "mcp__firecrawl__firecrawl_browser_delete"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)",
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git checkout .)",
      "Bash(git restore .)",
      "Bash(git add .)",
      "Bash(git add -A)",
      "Bash(: > *)",
      "Bash(> /etc/*)",
      "Bash(> /usr/*)",
      "Bash(> /System/*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/safety-guard.sh"
          }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/safety-guard.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/safety-guard.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/safety-guard.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify-input.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-sync-check.sh"
          }
        ]
      }
    ]
  }
}
